# --- Private: never commit -----------------------------------------------------
# Working data: audio, transcripts, extraction results, caches, error logs, the
# artifact copy of the page - and YOUR LOGIN SESSIONS (browser-profile*/, cookies.txt).
data/

# The local library: full transcripts and downloaded PDFs (other people's content).
# The public, link-only copy is generated into docs/.
library/

# Secrets (e.g. ANTHROPIC_API_KEY) if you ever keep them in a file
.env
.env.*
*.pem
*.key

# --- Python and tooling ----------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
pip-wheel-metadata/

# --- Temporary and partial files -------------------------------------------------
*.zip
*.tmp
*.temp
*.part
*.part-Frag*
*.ytdl
*.log
*.bak
~$*

# --- Editors and OS ---------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Screenshots the promo is rendered from (promo/make.py capture)
promo/captures/

# Login sessions and keys, wherever they end up (they normally live in data/)
cookies.txt
browser-profile*/
*.sqlite
*.ppk
id_rsa*
id_ed25519*

# --- Code: kept on this PC only; the repository publishes just the library -------
fblearn/
promo/
run.cmd
setup.cmd
requirements.txt
overrides.json
DEVELOPMENT.md
